# Supabase Authentication Configuration (OAuth only)
# Replace with your Supabase project credentials from Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Comma-separated list of designated administrator emails
# Authenticated users with these emails will automatically receive the 'admin' role
VITE_ADMIN_EMAILS=admin@4coreexim.com,exports@4coreexim.com
